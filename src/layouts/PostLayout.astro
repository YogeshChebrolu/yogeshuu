---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags: string[];
}

const { title, description, pubDate, updatedDate, tags } = Astro.props;
const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: '2-digit',
  });
---

<BaseLayout title={title} description={description}>
  <a
    href="/"
    class="inline-flex items-center gap-1 text-sm text-fg-dim no-underline hover:text-fg transition-colors"
    >← Back</a
  >

  <article class="mt-8">
    <header class="pb-8 mb-8 border-b border-line">
      <h1 class="font-serif-label text-2xl sm:text-3xl text-fg leading-[1.2]">
        {title}
      </h1>
      <p class="mt-4 text-sm text-fg-muted flex flex-wrap items-center gap-x-3 gap-y-1">
        <time datetime={pubDate.toISOString()}>{fmt(pubDate)}</time>
        {updatedDate && <span>· updated {fmt(updatedDate)}</span>}
        {
          tags.length > 0 && (
            <span class="flex flex-wrap gap-2">
              {tags.map((t) => (
                <span class="rounded-full border border-line px-2.5 py-0.5 text-xs text-fg-muted">
                  {t}
                </span>
              ))}
            </span>
          )
        }
      </p>
    </header>

    <div class="prose">
      <slot />
    </div>
  </article>
</BaseLayout>
