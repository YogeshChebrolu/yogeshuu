---
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';
import DockNav from '../components/DockNav.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../config';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = SITE.description } = Astro.props;
const pageTitle = title ? `${title} — ${SITE.title}` : SITE.title;
const socialTitle = title ? pageTitle : SITE.socialTitle;
const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url).toString();
const socialImage = new URL('/og-card-v2.png', Astro.site ?? SITE.url).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Work+Sans:wght@300;400;500;600;700&family=Fraunces:opsz,wght@9..144,300;9..144,400&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={socialTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1731" />
    <meta property="og:image:height" content="909" />
    <meta property="og:image:alt" content="Yogesh - Portfolio. I build full stack apps." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content="@yogesh_chebrolu" />
    <meta name="twitter:title" content={socialTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content="Yogesh - Portfolio. I build full stack apps." />

    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE.title}
      href="/rss.xml"
    />

    <!-- Apply saved theme before paint to avoid a flash -->
    <script is:inline>
      const t = localStorage.getItem('theme');
      if (t === 'light') document.documentElement.classList.add('light');
    </script>
    <Analytics />
  </head>
  <body class="min-h-screen flex flex-col overflow-x-clip">
    <DockNav />
    <main class="flex-1 w-full max-w-xl mx-auto px-5 sm:px-6 pt-20 sm:pt-24 pb-28">
      <slot />
    </main>
    <Footer />
  </body>
</html>
