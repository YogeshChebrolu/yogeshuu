---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, SOCIALS } from '../config';
---

<BaseLayout title="about" description={`About ${SITE.name}`}>
  <h1 class="text-sm text-fg-dim mb-6">
    <span class="text-accent">$</span> cat about.md
  </h1>

  <div class="prose">
    <p>
      Hi, I'm {SITE.name}. {SITE.bio.join(' ')}
    </p>

    <h2>What I do</h2>
    <p>
      Edit this page at <code>src/pages/about.astro</code> to tell your story.
      Write in HTML or swap it for Markdown — whatever you prefer.
    </p>

    <h2>Elsewhere</h2>
    <ul>
      {
        SOCIALS.map((s) => (
          <li>
            <a href={s.href} target="_blank" rel="me noopener">
              {s.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>
