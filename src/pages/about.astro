---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, SOCIALS } from '../config';
---

<BaseLayout title="about" description={`About ${SITE.name}`}>
  <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-fg mb-8">
    About
  </h1>

  <div class="prose">
    <p>
      Hi, I'm {SITE.name} 👋 — an AI Engineer building multi-modal AI systems
      and agentic workflows. I mostly automate my own life with them.
    </p>

    <h2>Technical skills</h2>
    <ul>
      <li><strong>Languages</strong> — Python · TypeScript · JavaScript · SQL</li>
      <li>
        <strong>AI / Agents</strong> — LangChain · LangGraph · MCP · AI SDK · RAG
        · Pydantic AI · CrewAI
      </li>
      <li><strong>ML</strong> — PyTorch · Deep Learning · NLP · Prompt Engineering</li>
      <li>
        <strong>Web</strong> — Next.js · React · FastAPI · Hono · Convex · Supabase
        · Tailwind
      </li>
      <li>
        <strong>Cloud &amp; Tools</strong> — AWS (Lambda · EC2 · ECS · ECR) ·
        Docker · Git · CI/CD
      </li>
    </ul>

    <h2>Elsewhere</h2>
    <ul>
      {
        SOCIALS.map((s) => (
          <li>
            <a href={s.href} target="_blank" rel="me noopener">
              {s.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>
