---
interface Props {
  title: string;
  description: string;
  pubDate: Date;
  tags: string[];
  href: string;
}
const { title, description, pubDate, tags, href } = Astro.props;
const date = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: '2-digit',
});
---

<article class="group py-5 border-b border-line last:border-b-0">
  <a href={href} class="no-underline block">
    <div class="flex items-baseline justify-between gap-4">
      <h2
        class="text-lg font-bold text-fg group-hover:text-accent transition-colors"
      >
        <span class="text-accent-2">&gt;</span>
        {title}
      </h2>
      <time class="shrink-0 text-xs text-fg-dim tabular-nums">{date}</time>
    </div>
    <p class="mt-1.5 text-sm text-fg-dim leading-relaxed">{description}</p>
    {
      tags.length > 0 && (
        <p class="mt-2 flex flex-wrap gap-2">
          {tags.map((t) => (
            <span class="text-xs text-accent">#{t}</span>
          ))}
        </p>
      )
    }
  </a>
</article>
