---
interface Props {
  title: string;
  description: string;
  pubDate: Date;
  tags: string[];
  href: string;
}
const { title, description, pubDate, tags, href } = Astro.props;
const date = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: '2-digit',
});
---

<article class="group border-b border-line last:border-b-0">
  <a href={href} class="no-underline block py-5">
    <div class="flex items-baseline justify-between gap-4">
      <h3
        class="text-base font-semibold text-fg group-hover:text-fg-dim transition-colors"
      >
        {title}
      </h3>
      <time class="shrink-0 text-xs text-fg-muted tabular-nums">{date}</time>
    </div>
    <p class="mt-1.5 text-sm text-fg-dim leading-relaxed">{description}</p>
    {
      tags.length > 0 && (
        <div class="mt-3 flex flex-wrap gap-2">
          {tags.map((t) => (
            <span class="rounded-full border border-line px-2.5 py-0.5 text-xs text-fg-muted">
              {t}
            </span>
          ))}
        </div>
      )
    }
  </a>
</article>
