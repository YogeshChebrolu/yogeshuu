---
import { SITE, SOCIALS } from '../config';
---

<section id="home" class="scroll-mt-40">
  <div class="flex items-center justify-between">
    <p class="font-serif-label text-lg text-fg">{SITE.role}</p>
  </div>

  <h1 class="mt-3 leading-snug text-fg text-lg sm:text-xl">
    {SITE.headline}
  </h1>

  <p class="mt-3 leading-snug text-fg/80 text-lg sm:text-xl">
    {SITE.tagline}
  </p>

  <div class="mt-6 flex flex-wrap items-center gap-3">
    <a
      href="mailto:chebroluyogesh25@gmail.com"
      class="inline-flex items-center rounded-md bg-fg px-4 py-2 text-sm font-medium text-bg no-underline transition-opacity hover:opacity-90"
    >
      Get in touch
    </a>
    <a
      href="/resume.pdf"
      target="_blank"
      rel="noopener"
      class="inline-flex items-center rounded-md border border-line px-4 py-2 text-sm font-medium text-fg no-underline transition-colors hover:border-fg-muted"
    >
      Resume
    </a>
  </div>

  <div class="mt-6 flex flex-wrap gap-x-5 gap-y-2 text-sm">
    {
      SOCIALS.map((s) => (
        <a
          href={s.href}
          target="_blank"
          rel="me noopener"
          class="text-fg-dim no-underline hover:text-fg transition-colors"
        >
          {s.label}
        </a>
      ))
    }
  </div>
</section>
