---
import { FileText } from 'lucide-react';
import { SITE, NAV } from '../config';
import { AppleStyleDock } from './AppleStyleDock';
import ThemeToggle from './ThemeToggle.astro';
import ProgressiveBlur from './ProgressiveBlur.astro';

const dockNav = NAV.filter((item) => item.label !== 'Experience' && item.label !== 'Resume');
const resumeItem = NAV.find((item) => item.label === 'Resume');
---

<div
  class="fixed top-5 left-5 right-5 sm:top-6 sm:left-6 sm:right-6 z-40 flex items-center justify-between"
>
  <a href="/" class="font-semibold tracking-tight text-fg no-underline">
    {SITE.name}<span class="text-fg-muted">.</span>
  </a>

  <div class="flex items-center gap-2">
    {
      resumeItem && (
        <a
          href={resumeItem.href}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-1.5 rounded-full border border-line bg-bg-soft px-3 sm:px-3.5 py-2 text-sm text-fg no-underline transition-colors hover:border-fg-muted"
        >
          <FileText className="h-4 w-4 shrink-0" />
          <span class="hidden sm:inline">Resume</span>
        </a>
      )
    }
    <ThemeToggle />
  </div>
</div>

<ProgressiveBlur />
<AppleStyleDock nav={dockNav} client:load />
