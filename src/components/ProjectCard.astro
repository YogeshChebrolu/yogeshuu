---
/*
 * One project preview in the home-page "Works" stack — a large
 * screenshot on a blurred backdrop, with the name and links below.
 */
interface Props {
  name: string;
  description: string;
  image: string;
  tags: string[];
  repo?: string;
  demo?: string;
}
const { name, description, image, tags, repo, demo } = Astro.props;
const primary = demo ?? repo;
---

<article class="group">
  <a
    href={primary}
    target="_blank"
    rel="noopener"
    class="block relative aspect-video rounded-2xl border border-line bg-bg-soft overflow-hidden"
  >
    <img
      src={image}
      alt=""
      aria-hidden="true"
      loading="lazy"
      class="absolute inset-0 h-full w-full scale-110 object-cover object-top opacity-40 blur-2xl grayscale"
    />
    <div class="absolute inset-0 flex items-center justify-center p-4 sm:p-8">
      <img
        src={image}
        alt={`${name} preview`}
        loading="lazy"
        class="h-full w-full rounded-lg border border-line object-cover object-top shadow-2xl transition-transform duration-500 group-hover:scale-[1.02]"
      />
    </div>
  </a>

  <div class="mt-4 flex flex-wrap items-center justify-between gap-x-4 gap-y-3">
    <div>
      <h3 class="font-serif-label text-xl text-fg">{name}</h3>
      <p class="mt-1 text-sm text-fg-dim leading-relaxed max-w-md">{description}</p>
      {
        tags.length > 0 && (
          <div class="mt-2 flex flex-wrap gap-2">
            {tags.map((t) => (
              <span class="rounded-full border border-line px-2.5 py-0.5 text-xs text-fg-muted">
                {t}
              </span>
            ))}
          </div>
        )
      }
    </div>

    <div class="flex items-center gap-2 shrink-0">
      {
        repo && (
          <a
            href={repo}
            target="_blank"
            rel="noopener"
            aria-label={`${name} on GitHub`}
            class="grid place-items-center h-9 w-9 rounded-lg border border-line text-fg-dim no-underline transition-colors hover:text-fg hover:border-fg-muted"
          >
            <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
              <path d="M12 .5C5.73.5.98 5.24.98 11.52c0 4.94 3.2 9.13 7.65 10.6.56.1.76-.24.76-.54 0-.27-.01-1.16-.02-2.1-3.11.68-3.77-1.32-3.77-1.32-.5-1.29-1.24-1.63-1.24-1.63-1.01-.7.08-.68.08-.68 1.12.08 1.71 1.15 1.71 1.15 1 1.71 2.62 1.22 3.26.93.1-.72.39-1.22.71-1.5-2.48-.28-5.1-1.24-5.1-5.53 0-1.22.44-2.22 1.15-3-.11-.28-.5-1.42.11-2.96 0 0 .94-.3 3.08 1.15a10.7 10.7 0 0 1 5.6 0c2.14-1.45 3.08-1.15 3.08-1.15.61 1.54.22 2.68.11 2.96.72.78 1.15 1.78 1.15 3 0 4.3-2.63 5.24-5.13 5.52.4.35.76 1.03.76 2.08 0 1.5-.01 2.71-.01 3.08 0 .3.2.65.77.54A10.53 10.53 0 0 0 23.02 11.5C23.02 5.24 18.27.5 12 .5Z" />
            </svg>
          </a>
        )
      }
      {
        demo && (
          <a
            href={demo}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-1.5 rounded-lg bg-fg px-3.5 py-2 text-sm font-medium text-bg no-underline transition-opacity hover:opacity-90"
          >
            Live demo
            <span aria-hidden="true">&#8599;</span>
          </a>
        )
      }
    </div>
  </div>
</article>
