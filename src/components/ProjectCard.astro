---
/*
 * One project tile in the home-page "Works" grid.
 */
interface Props {
  name: string;
  description: string;
  tags: string[];
  repo?: string;
  demo?: string;
}
const { name, description, tags, repo, demo } = Astro.props;
const primary = demo ?? repo;
const linkClass =
  'text-fg-dim no-underline hover:text-fg transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-fg';
---

<article
  class="group flex flex-col rounded-xl border border-line bg-bg-soft p-5 transition-colors hover:border-fg-muted"
>
  <div class="flex items-start justify-between gap-3">
    <h3 class="font-semibold text-fg">
      {
        primary ? (
          <a
            href={primary}
            target="_blank"
            rel="noopener"
            class="no-underline text-fg after:absolute"
          >
            {name}
          </a>
        ) : (
          name
        )
      }
    </h3>
    {
      primary && (
        <span
          class="shrink-0 text-fg-muted transition-all group-hover:text-fg group-hover:-translate-y-0.5 group-hover:translate-x-0.5"
          aria-hidden="true"
        >
          ↗
        </span>
      )
    }
  </div>

  <p class="mt-2 text-sm text-fg-dim leading-relaxed">{description}</p>

  {
    tags.length > 0 && (
      <div class="mt-4 flex flex-wrap gap-2">
        {tags.map((t) => (
          <span class="rounded-full border border-line px-2.5 py-0.5 text-xs text-fg-muted">
            {t}
          </span>
        ))}
      </div>
    )
  }

  {
    (repo || demo) && (
      <div class="mt-4 flex flex-wrap items-center gap-x-3 text-sm">
        {repo && (
          <a href={repo} target="_blank" rel="noopener" class={linkClass}>
            Repo
          </a>
        )}
        {repo && demo && <span class="text-fg-muted">·</span>}
        {demo && (
          <a href={demo} target="_blank" rel="noopener" class={linkClass}>
            Live demo
          </a>
        )}
      </div>
    )
  }
</article>
