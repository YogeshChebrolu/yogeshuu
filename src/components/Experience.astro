---
import { EXPERIENCE } from '../config';
---

<section id="experience" class="scroll-mt-40 py-6">
  <h2 class="font-serif-label text-lg text-fg py-5">Experience</h2>

  <div class="relative">
    <div class="absolute left-[5px] top-2 bottom-2 w-px bg-line" aria-hidden="true"></div>

    <div class="flex flex-col gap-10">
      {
        EXPERIENCE.map((job) => (
          <div class="relative pl-8">
            <span
              class:list={[
                'absolute left-0 top-1.5 h-[11px] w-[11px] rounded-full border-2',
                job.current
                  ? 'bg-emerald-400 border-emerald-400 shadow-[0_0_8px_2px] shadow-emerald-400/40'
                  : 'bg-bg border-fg-muted',
              ]}
              aria-hidden="true"
            />

            <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
              <h3 class="font-semibold text-fg">
                {job.role}
                <span class="text-fg-muted font-normal"> · </span>
                {job.orgHref ? (
                  <a
                    href={job.orgHref}
                    target="_blank"
                    rel="noopener"
                    class="text-fg no-underline hover:text-fg-dim transition-colors"
                  >
                    {job.org}
                  </a>
                ) : (
                  <span class="text-fg">{job.org}</span>
                )}
              </h3>
              <span class="text-sm text-fg-muted tabular-nums">{job.period}</span>
            </div>

            {job.type && <p class="mt-0.5 text-sm text-fg-muted">{job.type}</p>}

            {job.summary && (
              <p class="mt-3 text-sm text-fg-dim leading-relaxed">{job.summary}</p>
            )}

            {job.points && job.points.length > 0 && (
              <ul class="mt-3 space-y-1.5">
                {job.points.map((point) => (
                  <li class="text-sm text-fg-dim leading-relaxed flex gap-2">
                    <span class="text-fg-muted">·</span>
                    <span>
                      {typeof point === 'string'
                        ? point
                        : point.parts.map((part) =>
                            typeof part === 'string' ? (
                              part
                            ) : (
                              <code class="rounded border border-line bg-bg-soft px-1 py-0.5 font-mono text-[0.85em] text-fg-dim">
                                {part.code}
                              </code>
                            )
                          )}
                    </span>
                  </li>
                ))}
              </ul>
            )}

            {job.detailPoints && job.detailPoints.length > 0 && (
              <details class="experience-detail mt-2">
                <summary class="inline-flex cursor-pointer list-none rounded-sm text-xs text-fg-muted transition-colors hover:text-fg-dim focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-fg-muted">
                  <span class="more-label">→ more detail</span>
                  <span class="less-label">← less</span>
                </summary>
                <ul class="mt-3 space-y-3">
                  {job.detailPoints.map((point) => (
                    <li class="text-sm text-fg-dim leading-relaxed flex gap-2">
                      <span class="text-fg-muted">·</span>
                      <span>
                        {typeof point === 'string'
                          ? point
                          : point.parts.map((part) =>
                              typeof part === 'string' ? (
                                part
                              ) : (
                                <code class="rounded border border-line bg-bg-soft px-1 py-0.5 font-mono text-[0.85em] text-fg-dim">
                                  {part.code}
                                </code>
                              )
                            )}
                      </span>
                    </li>
                  ))}
                </ul>
              </details>
            )}

            {job.stack.length > 0 && (
              <div class="mt-4 flex flex-wrap gap-2">
                {job.stack.map((s) => (
                  <span class="grid place-items-center h-8 min-w-8 px-2 rounded-lg border border-line bg-bg-soft text-xs text-fg-dim">
                    {s}
                  </span>
                ))}
              </div>
            )}
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .experience-detail summary::-webkit-details-marker {
    display: none;
  }

  .experience-detail .less-label {
    display: none;
  }

  .experience-detail[open] .more-label {
    display: none;
  }

  .experience-detail[open] .less-label {
    display: inline;
  }
</style>