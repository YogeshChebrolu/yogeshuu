---
import { EXPERIENCE } from '../config';
---

<section id="experience" class="scroll-mt-20 mt-20 sm:mt-24">
  <div class="flex items-baseline justify-between">
    <h2 class="text-xl font-bold tracking-tight text-fg">Experience</h2>
    <span class="text-sm text-fg-muted">Where I've worked</span>
  </div>

  <div class="mt-6 flex flex-col">
    {
      EXPERIENCE.map((job) => (
        <div class="grid grid-cols-1 sm:grid-cols-[9rem_1fr] gap-x-6 gap-y-1.5 py-6 border-b border-line last:border-b-0">
          <p class="text-sm text-fg-muted tabular-nums">{job.period}</p>
          <div>
            <h3 class="font-semibold text-fg">
              {job.role} ·{' '}
              {job.orgHref ? (
                <a
                  href={job.orgHref}
                  target="_blank"
                  rel="noopener"
                  class="text-fg no-underline hover:text-fg-dim transition-colors"
                >
                  {job.org}
                </a>
              ) : (
                job.org
              )}
            </h3>
            <ul class="mt-2 space-y-1.5">
              {job.points.map((point) => (
                <li class="text-sm text-fg-dim leading-relaxed flex gap-2">
                  <span class="text-fg-muted">–</span>
                  <span>{point}</span>
                </li>
              ))}
            </ul>
            <div class="mt-3 flex flex-wrap gap-2">
              {job.stack.map((s) => (
                <span class="rounded-full border border-line px-2.5 py-0.5 text-xs text-fg-muted">
                  {s}
                </span>
              ))}
            </div>
          </div>
        </div>
      ))
    }
  </div>
</section>
