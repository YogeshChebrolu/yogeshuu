---
import type { ContributionData } from '../lib/github';

interface Props {
  username: string;
  data: ContributionData | null;
}
const { username, data } = Astro.props;

// GitHub's own 0-4 buckets, mapped to increasing opacity of the same fg color
// so levels stay clearly distinct on the dark theme.
const LEVEL_OPACITY = [0.06, 0.25, 0.45, 0.7, 1] as const;

type Cell = { date: string; level: number; tooltip: string } | null;

let weeks: Cell[][] = [];
let monthLabels: { index: number; label: string }[] = [];

if (data) {
  // GitHub's calendar is a grid of weeks (columns) × weekdays (rows, Sun→Sat).
  // Anchor the grid to the Sunday on/before the first day so every day lands
  // in a deterministic (week, weekday) slot regardless of gaps in the data.
  const first = new Date(`${data.days[0].date}T00:00:00Z`);
  const gridStart = new Date(first);
  gridStart.setUTCDate(first.getUTCDate() - first.getUTCDay());

  const dayMs = 86400000;
  let maxWeek = 0;
  const slotted: { week: number; weekday: number; day: (typeof data.days)[number] }[] = [];

  for (const day of data.days) {
    const d = new Date(`${day.date}T00:00:00Z`);
    const week = Math.floor((d.getTime() - gridStart.getTime()) / (7 * dayMs));
    if (week < 0) continue;
    maxWeek = Math.max(maxWeek, week);
    slotted.push({ week, weekday: d.getUTCDay(), day });
  }

  weeks = Array.from({ length: maxWeek + 1 }, () => Array<Cell>(7).fill(null));
  for (const { week, weekday, day } of slotted) {
    weeks[week][weekday] = day;
  }

  // One month label per column where the month first appears, then drop any
  // label sitting right on top of the next one (a thin sliver at the edges).
  let lastMonth = -1;
  weeks.forEach((week, i) => {
    const firstDay = week.find((d): d is NonNullable<Cell> => d !== null);
    if (!firstDay) return;
    const month = new Date(`${firstDay.date}T00:00:00Z`).getUTCMonth();
    if (month !== lastMonth) {
      monthLabels.push({
        index: i,
        label: new Date(`${firstDay.date}T00:00:00Z`).toLocaleDateString('en-US', {
          month: 'short',
          timeZone: 'UTC',
        }),
      });
      lastMonth = month;
    }
  });
  monthLabels = monthLabels.filter(
    (m, i) => i === monthLabels.length - 1 || monthLabels[i + 1].index - m.index >= 3
  );
}

const CELL = 11;
const GAP = 3;
const STEP = CELL + GAP;
const HEADER = CELL + GAP + 2; // vertical space reserved for the month row
const WEEKDAY_LABELS: Record<number, string> = { 1: 'Mon', 3: 'Wed', 5: 'Fri' };
---

{
  data ? (
    <div
      class="cg-scroll overflow-x-auto"
      style={`--cell:${CELL}px; --gap:${GAP}px; --step:${STEP}px; --header:${HEADER}px`}
    >
      <div class="inline-flex gap-2">
        {/* weekday labels */}
        <div
          class="flex shrink-0 flex-col text-[10px] leading-none text-fg-muted"
          style="gap:var(--gap); margin-top:var(--header)"
        >
          {Array.from({ length: 7 }, (_, i) => (
            <div style="height:var(--cell); line-height:var(--cell)">{WEEKDAY_LABELS[i] ?? ''}</div>
          ))}
        </div>

        <div>
          {/* month labels */}
          <div class="relative text-[10px] text-fg-muted" style="height:var(--header)">
            {monthLabels.map((m) => (
              <span class="absolute top-0" style={`left:${m.index * STEP}px`}>
                {m.label}
              </span>
            ))}
          </div>

          {/* week columns */}
          <div class="flex" style="gap:var(--gap)">
            {weeks.map((week) => (
              <div class="flex flex-col" style="gap:var(--gap)">
                {week.map((day, weekday) =>
                  day ? (
                    <div
                      class="group/cell relative"
                      style="width:var(--cell); height:var(--cell)"
                    >
                      <span
                        aria-label={day.tooltip}
                        class="block h-full w-full rounded-[2px] bg-fg transition-transform duration-100 group-hover/cell:scale-125"
                        style={`opacity:${LEVEL_OPACITY[day.level] ?? LEVEL_OPACITY[0]}`}
                      />
                      <span
                        role="tooltip"
                        class:list={[
                          'pointer-events-none absolute left-1/2 z-20 -translate-x-1/2 scale-95 whitespace-nowrap rounded-md border border-line bg-bg-card px-2 py-1 text-[11px] text-fg opacity-0 shadow-lg transition-all duration-100 group-hover/cell:scale-100 group-hover/cell:opacity-100',
                          // Top row's upward tooltip gets clipped by the scroll
                          // container, so flip it below the cell instead.
                          weekday === 0 ? 'top-full mt-2' : 'bottom-full mb-2',
                        ]}
                      >
                        {day.tooltip}
                      </span>
                    </div>
                  ) : (
                    <span class="block" style="width:var(--cell); height:var(--cell)" />
                  )
                )}
              </div>
            ))}
          </div>

          {/* legend */}
          <div class="mt-3 flex items-center gap-1.5 text-[10px] text-fg-muted">
            <span class="mr-0.5">Less</span>
            {LEVEL_OPACITY.map((opacity) => (
              <span
                class="block rounded-[2px] bg-fg"
                style={`width:var(--cell); height:var(--cell); opacity:${opacity}`}
              />
            ))}
            <span class="ml-0.5">More</span>
          </div>
        </div>
      </div>
    </div>
  ) : (
    <p class="text-sm text-fg-muted">
      Couldn't load GitHub contributions right now —{' '}
      <a
        href={`https://github.com/${username}`}
        target="_blank"
        rel="noopener"
        class="underline hover:text-fg"
      >
        see the profile directly
      </a>
      .
    </p>
  )
}

<style>
  /* Hide the scrollbar on the graph — it still scrolls horizontally on small
     screens, just without the chrome the design doesn't want. */
  .cg-scroll {
    scrollbar-width: none; /* Firefox */
    -ms-overflow-style: none; /* old Edge/IE */
  }
  .cg-scroll::-webkit-scrollbar {
    display: none; /* Chrome/Safari */
  }
</style>

<script>
  // On narrow viewports the graph overflows; start it scrolled to the most
  // recent week so the newest activity is what you see first.
  function alignGraphs() {
    document.querySelectorAll<HTMLElement>('.cg-scroll').forEach((el) => {
      el.scrollLeft = el.scrollWidth;
    });
  }
  alignGraphs();
  window.addEventListener('resize', alignGraphs);
</script>
