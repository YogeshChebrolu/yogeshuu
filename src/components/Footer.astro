---
import { SITE, SOCIALS } from '../config';
const year = new Date().getFullYear();
---

<footer class="border-t border-line mt-16">
  <div
    class="max-w-3xl mx-auto px-5 sm:px-6 pt-8 pb-28 sm:pb-32 flex flex-wrap items-center justify-between gap-3 text-sm text-fg-muted"
  >
    <p>© {year} {SITE.name}</p>
    <p class="flex items-center gap-4">
      {
        SOCIALS.map((s) => (
          <a
            href={s.href}
            target="_blank"
            rel="me noopener"
            class="no-underline hover:text-fg transition-colors"
          >
            {s.label}
          </a>
        ))
      }
    </p>
  </div>
</footer>
