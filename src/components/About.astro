---
import { SITE, ABOUT_INTRO, TOOLS, FOCUS_AREAS } from '../config';
import { getGithubContributions } from '../lib/github';
import ContributionGraph from './ContributionGraph.astro';

const contributions = await getGithubContributions(SITE.githubUsername);

/** Generic monoline icons (Feather/Lucide-style) for concepts with no brand logo. */
const ICONS: Record<string, string> = {
  search:
    '<circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/>',
  message:
    '<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>',
  layers:
    '<path d="m12 2 9 5-9 5-9-5z"/><path d="m3 12 9 5 9-5"/><path d="m3 17 9 5 9-5"/>',
  terminal:
    '<polyline points="4 17 10 11 4 5"/><line x1="12" x2="20" y1="19" y2="19"/>',
  cloud:
    '<path d="M17.5 19H9a7 7 0 1 1 6.71-9h.79a4.5 4.5 0 1 1 0 9Z"/>',
  infinity:
    '<path d="M18.178 8c5.096 0 5.096 8 0 8-5.095 0-7.133-8-12.739-8-4.585 0-4.585 8 0 8 5.606 0 7.644-8 12.74-8z"/>',
};
---

<section id="about" class="scroll-mt-40 py-6">
  <h2 class="font-serif-label text-lg text-fg py-5">About</h2>

  <p class="text-sm text-fg-dim leading-relaxed max-w-md">{ABOUT_INTRO}</p>

  <div class="mt-6 flex flex-wrap gap-2" data-pill-group>
    {
      TOOLS.map((t) => (
        <div
          data-pill
          class="group flex items-center h-11 rounded-full border border-line bg-bg-soft overflow-hidden transition-colors hover:border-fg-muted"
        >
          <span class="grid place-items-center h-11 w-11 shrink-0">
            <img
              src={`https://cdn.simpleicons.org/${t.slug}${t.color ? `/${t.color}` : ''}`}
              alt={t.name}
              width="18"
              height="18"
              loading="lazy"
            />
          </span>
          <span class="grid grid-cols-[0fr] group-hover:grid-cols-[1fr] transition-[grid-template-columns] duration-300 ease-out">
            <span
              data-pill-label
              class="block overflow-hidden text-ellipsis whitespace-nowrap text-sm text-fg-dim"
            >
              <span data-pill-text class="inline-block pr-4">{t.name}</span>
            </span>
          </span>
        </div>
      ))
    }
  </div>

  {
    FOCUS_AREAS.length > 0 && (
      <div class="mt-5 flex flex-wrap gap-2" data-pill-group>
        {FOCUS_AREAS.map((f) => (
          <div
            data-pill
            class="group flex items-center h-11 rounded-full border border-line bg-bg-soft overflow-hidden transition-colors hover:border-fg-muted"
          >
            <span class="grid place-items-center h-11 w-11 shrink-0">
              {f.slug ? (
                <img
                  src={`https://cdn.simpleicons.org/${f.slug}${f.color ? `/${f.color}` : ''}`}
                  alt={f.name}
                  width="18"
                  height="18"
                  loading="lazy"
                />
              ) : (
                <svg
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="text-fg-dim"
                  aria-hidden="true"
                  set:html={ICONS[f.icon ?? '']}
                />
              )}
            </span>
            <span class="grid grid-cols-[0fr] group-hover:grid-cols-[1fr] transition-[grid-template-columns] duration-300 ease-out">
              <span
                data-pill-label
                class="block overflow-hidden text-ellipsis whitespace-nowrap text-sm text-fg-dim"
              >
                <span data-pill-text class="inline-block pr-4">{f.name}</span>
              </span>
            </span>
          </div>
        ))}
      </div>
    )
  }

  <div class="mt-8">
    <ContributionGraph username={SITE.githubUsername} data={contributions} />
    <p class="mt-3 text-xs text-fg-muted">
      {
        contributions
          ? `${contributions.total.toLocaleString()} contributions ${contributions.periodLabel}`
          : 'Contributions'
      }{' '}
      on{' '}
      <a
        href={`https://github.com/${SITE.githubUsername}`}
        target="_blank"
        rel="noopener"
        class="underline decoration-fg-muted hover:text-fg hover:decoration-fg transition-colors"
      >
        GitHub
      </a>
      .
    </p>
  </div>
</section>

<script>
  // ---------------------------------------------------------------------
  // Flicker-proof expanding pills via slack-aware row packing.
  //
  // Instead of letting flex-wrap decide where rows break, we pack the
  // pills into explicit rows ourselves, with one rule: a pill only joins
  // a row if (collapsed widths of the row) + (widest label in the row,
  // including this pill's) still fits in the container. That guarantees
  // that when ANY pill in the row expands, the row absorbs it without
  // wrapping — so the hovered pill never jumps lines and never flickers.
  //
  // Everything is measured at runtime (labels have a real width even
  // while collapsed), and we re-pack on resize and after fonts load, so
  // nothing is hardcoded.
  // ---------------------------------------------------------------------
  const GAP = 8; // gap-2
  const SLACK = 2; // subpixel safety margin

  document.querySelectorAll('[data-pill-group]').forEach((groupEl) => {
    const group = groupEl as HTMLElement;
    const pills = Array.from(group.querySelectorAll<HTMLElement>('[data-pill]'));
    if (pills.length === 0) return;

    const labelWidth = (pill: HTMLElement) => {
      const text = pill.querySelector<HTMLElement>('[data-pill-text]');
      return text ? Math.ceil(text.getBoundingClientRect().width) : 0;
    };

    const pack = () => {
      // Flatten: move pills back into the group, drop old row wrappers.
      pills.forEach((p) => group.appendChild(p));
      group.querySelectorAll('[data-pill-line]').forEach((l) => l.remove());

      const containerW = group.clientWidth;
      const collapsedW = Math.ceil(pills[0].getBoundingClientRect().width) || 46;

      let line: HTMLElement | null = null;
      let lineW = 0; // sum of collapsed pill widths + gaps in current row
      let maxLabel = 0; // widest label in current row
      let count = 0;

      const startLine = () => {
        line = document.createElement('div');
        line.setAttribute('data-pill-line', '');
        line.className = 'flex gap-2 w-full';
        group.appendChild(line);
        lineW = 0;
        maxLabel = 0;
        count = 0;
      };

      startLine();
      pills.forEach((pill) => {
        const lw = labelWidth(pill);
        if (count > 0) {
          const tryW = lineW + GAP + collapsedW;
          const tryMax = Math.max(maxLabel, lw);
          if (tryW + tryMax + SLACK > containerW) startLine();
        }
        line!.appendChild(pill);
        lineW = count === 0 ? collapsedW : lineW + GAP + collapsedW;
        maxLabel = Math.max(maxLabel, lw);
        count++;
      });
    };

    // Safety net: if a label is somehow wider than the whole container
    // (or a measurement drifts by a pixel), cap it at the row edge with
    // an ellipsis so a wrap remains impossible.
    pills.forEach((pill) => {
      const label = pill.querySelector<HTMLElement>('[data-pill-label]');
      const text = pill.querySelector<HTMLElement>('[data-pill-text]');
      if (!label || !text) return;
      pill.addEventListener('pointerenter', () => {
        const rect = pill.getBoundingClientRect();
        const available = Math.floor(
          group.getBoundingClientRect().right - rect.left - rect.width - SLACK
        );
        const natural = Math.ceil(text.getBoundingClientRect().width);
        label.style.maxWidth = natural > available ? `${Math.max(available, 0)}px` : '';
      });
    });

    pack();

    // Web fonts can change label widths after first paint.
    if (document.fonts?.ready) document.fonts.ready.then(pack);

    let t: ReturnType<typeof setTimeout>;
    let lastW = group.clientWidth;
    window.addEventListener('resize', () => {
      clearTimeout(t);
      t = setTimeout(() => {
        if (group.clientWidth !== lastW) {
          lastW = group.clientWidth;
          pack();
        }
      }, 120);
    });
  });
</script>
