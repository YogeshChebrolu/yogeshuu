---
import { ABOUT_INTRO, TOOLS, FOCUS_AREAS, SOCIALS } from '../config';
---

<section id="about" class="scroll-mt-40 py-6">
  <h2 class="font-serif-label text-lg text-fg py-5">About</h2>

  <p class="text-sm text-fg-dim leading-relaxed max-w-md">{ABOUT_INTRO}</p>

  <div class="mt-6 flex flex-wrap gap-2">
    {
      TOOLS.map((t) => (
        <div
          class="group flex items-center h-11 rounded-full border border-line bg-bg-soft overflow-hidden transition-colors hover:border-fg-muted"
        >
          <span class="grid place-items-center h-11 w-11 shrink-0">
            <img
              src={`https://cdn.simpleicons.org/${t.slug}${t.color ? `/${t.color}` : ''}`}
              alt={t.name}
              width="18"
              height="18"
              loading="lazy"
            />
          </span>
          <span class="grid grid-cols-[0fr] group-hover:grid-cols-[1fr] transition-[grid-template-columns] duration-300 ease-out">
            <span class="overflow-hidden whitespace-nowrap text-sm text-fg-dim">
              <span class="inline-block pr-4">{t.name}</span>
            </span>
          </span>
        </div>
      ))
    }
  </div>

  {
    FOCUS_AREAS.length > 0 && (
      <div class="mt-5 flex flex-wrap gap-2">
        {FOCUS_AREAS.map((f) => (
          <span class="rounded-full border border-line px-2.5 py-0.5 text-xs text-fg-muted">
            {f}
          </span>
        ))}
      </div>
    )
  }

  <div class="mt-8 flex flex-wrap gap-x-5 gap-y-2 text-sm">
    {
      SOCIALS.map((s) => (
        <a
          href={s.href}
          target="_blank"
          rel="me noopener"
          class="text-fg-dim no-underline hover:text-fg transition-colors"
        >
          {s.label}
        </a>
      ))
    }
  </div>
</section>
