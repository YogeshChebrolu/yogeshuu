---
import { SITE, SOCIALS } from '../config';
const prompt = `${SITE.user}@${SITE.host}`;
---

<section class="mt-8">
  <div class="rounded-lg border border-line bg-bg-soft overflow-hidden shadow-sm">
    <!-- title bar -->
    <div class="flex items-center gap-2 px-4 py-2.5 border-b border-line">
      <span class="w-3 h-3 rounded-full bg-[#ff5f56]"></span>
      <span class="w-3 h-3 rounded-full bg-[#ffbd2e]"></span>
      <span class="w-3 h-3 rounded-full bg-[#27c93f]"></span>
      <span class="ml-2 text-xs text-fg-dim">{prompt}: ~</span>
    </div>

    <!-- terminal body -->
    <div class="px-5 py-5 text-sm leading-relaxed">
      <p class="text-fg-dim">
        <span class="text-accent">{prompt}</span>:<span class="text-accent-2"
          >~</span
        >$ <span class="text-fg">whoami</span>
      </p>
      <p class="mt-1 text-xl sm:text-2xl font-bold text-fg">{SITE.name}</p>

      <p class="mt-4 text-fg-dim">
        <span class="text-accent">{prompt}</span>:<span class="text-accent-2"
          >~</span
        >$ <span class="text-fg">cat bio.txt</span>
      </p>
      {SITE.bio.map((line) => <p class="mt-1 text-fg">{line}</p>)}

      <p class="mt-4 text-fg-dim">
        <span class="text-accent">{prompt}</span>:<span class="text-accent-2"
          >~</span
        >$ <span class="text-fg">ls ./links</span>
      </p>
      <p class="mt-1 flex flex-wrap gap-x-5 gap-y-1">
        {
          SOCIALS.map((s) => (
            <a
              href={s.href}
              target="_blank"
              rel="me noopener"
              class="text-accent-2 no-underline hover:text-accent transition-colors"
            >
              {s.label}
            </a>
          ))
        }
      </p>

      <p class="mt-4 text-fg-dim">
        <span class="text-accent">{prompt}</span>:<span class="text-accent-2"
          >~</span
        >$ <span class="cursor"></span>
      </p>
    </div>
  </div>
</section>
