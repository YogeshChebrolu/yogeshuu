---
/*
 * Home-page "Works" section — a section heading over a grid of ProjectCards.
 */
import { PROJECTS } from '../config';
import ProjectCard from './ProjectCard.astro';
---

<section id="works" class="scroll-mt-20 mt-20 sm:mt-24" aria-label="Works">
  <div class="flex items-baseline justify-between">
    <h2 class="text-xl font-bold tracking-tight text-fg">Works</h2>
    <span class="text-sm text-fg-muted">Selected projects</span>
  </div>

  {
    PROJECTS.length === 0 ? (
      <p class="text-fg-muted text-sm py-6">No projects yet.</p>
    ) : (
      <div class="mt-6 grid gap-4 sm:grid-cols-2">
        {PROJECTS.map((p) => (
          <ProjectCard
            name={p.name}
            description={p.description}
            tags={p.tags}
            repo={p.repo}
            demo={p.demo}
          />
        ))}
      </div>
    )
  }
</section>
