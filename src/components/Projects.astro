---
/*
 * Home-page projects section — a prompt-line header over a grid of ProjectCards.
 * Spec: docs/design/projects-grid.md
 */
import { SITE, PROJECTS } from '../config';
import ProjectCard from './ProjectCard.astro';
const prompt = `${SITE.user}@${SITE.host}`;
---

<section class="mt-12" aria-label="Projects">
  <h2 class="text-sm text-fg-dim mb-3">
    <span class="text-accent">{prompt}</span>:<span class="text-accent-2">~</span
    >$ <span class="text-fg">ls ./projects</span>
  </h2>

  {
    PROJECTS.length === 0 ? (
      <p class="text-fg-dim text-sm py-6"># no projects yet</p>
    ) : (
      <div class="grid gap-4 sm:grid-cols-2">
        {PROJECTS.map((p) => (
          <ProjectCard
            name={p.name}
            description={p.description}
            tags={p.tags}
            repo={p.repo}
            demo={p.demo}
          />
        ))}
      </div>
    )
  }
</section>
