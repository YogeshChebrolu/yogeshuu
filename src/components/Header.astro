---
import { SITE, NAV } from '../config';
const path = Astro.url.pathname;
---

<header class="flex items-center justify-between py-6 border-b border-line">
  <a href="/" class="group flex items-center gap-2 text-fg no-underline">
    <span class="text-accent">$</span>
    <span class="font-bold tracking-tight group-hover:text-accent transition-colors"
      >{SITE.user}@{SITE.host}</span
    >
  </a>

  <nav class="flex items-center gap-5 text-sm">
    {
      NAV.map((item) => {
        const active =
          item.href === '/' ? path === '/' : path.startsWith(item.href);
        return (
          <a
            href={item.href}
            class:list={[
              'no-underline transition-colors hover:text-accent',
              active ? 'text-accent' : 'text-fg-dim',
            ]}
          >
            {active && <span class="text-accent">./</span>}
            {item.label}
          </a>
        );
      })
    }
    <button
      id="theme-toggle"
      type="button"
      aria-label="Toggle theme"
      class="text-fg-dim hover:text-accent transition-colors cursor-pointer"
    >
      <span id="theme-icon">☾</span>
    </button>
  </nav>
</header>

<script is:inline>
  (() => {
    const btn = document.getElementById('theme-toggle');
    const icon = document.getElementById('theme-icon');
    const setIcon = () =>
      (icon.textContent = document.documentElement.classList.contains('light')
        ? '☀'
        : '☾');
    setIcon();
    btn?.addEventListener('click', () => {
      const isLight = document.documentElement.classList.toggle('light');
      localStorage.setItem('theme', isLight ? 'light' : 'dark');
      setIcon();
    });
  })();
</script>
